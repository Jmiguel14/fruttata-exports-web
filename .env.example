# Contact form feature flag. Only the exact value "true" enables the form.
# When off (or unset), the contact page shows WhatsApp buttons and contact details.
CONTACT_FORM_ENABLED=false

# Resend (https://resend.com). Required when the form is enabled.
RESEND_API_KEY=
# Must belong to a domain verified in Resend, e.g. "Fruttata Web <web@fruttataglobal.com>"
RESEND_FROM_EMAIL=

# Where inquiries are delivered. Comma-separated lists are allowed.
CONTACT_TO_EMAIL=comercial@fruttataglobal.com
CONTACT_CC_EMAIL=info@fruttataglobal.com

# Public site URL used for canonical links, hreflang, sitemap, and Open Graph.
# Falls back to the Vercel production domain, then to https://fruttataglobal.com.
NEXT_PUBLIC_SITE_URL=https://fruttataglobal.com
